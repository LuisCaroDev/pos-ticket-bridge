{
  "name": "pos-ticket-bridge",
  "productName": "POS Ticket Bridge",
  "version": "1.0.3",
  "description": "Puente local de impresión ESC/POS para puntos de venta.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "prepare:electron-zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-electron-zip.ps1",
    "rebuild:native": "electron-rebuild -f -w serialport -w usb",
    "make:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows.ps1",
    "make:win:rebuild": "npm run rebuild:native && npm run make:win",
    "make:mac": "npm run rebuild:native && electron-forge make --platform=darwin",
    "publish": "electron-forge publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --ext .ts,.tsx,.mts .",
    "test": "vitest run"
  },
  "keywords": [],
  "author": {
    "name": "LuisCaroDev",
    "email": "luisangelcarogaloc@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~4.5.4",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fastify/cors": "^11.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@node-escpos/core": "^0.6.0",
    "@node-escpos/network-adapter": "^0.0.1",
    "@node-escpos/serialport-adapter": "^1.0.0",
    "@node-escpos/usb-adapter": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "fastify": "^5.10.0",
    "lucide-react": "^1.27.0",
    "node-thermal-printer": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^4.12.2",
    "serialport": "^13.0.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "usb": "^3.0.1",
    "zod": "^4.4.3"
  }
}
