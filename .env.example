# Public help-video URLs. Leave empty to hide the video link for that OS.
POS_BRIDGE_HTTPS_VIDEO_IOS="https://192.168.18.17:9977/health"
POS_BRIDGE_HTTPS_VIDEO_ANDROID="https://192.168.18.17:9977/health"
POS_BRIDGE_HTTPS_VIDEO_WINDOWS="https://192.168.18.17:9977/health"
POS_BRIDGE_HTTPS_VIDEO_MACOS="https://192.168.18.17:9977/health"

# Lifetime of each setup download session, in milliseconds. Default: 600000 (10 minutes).
POS_BRIDGE_HTTPS_SETUP_TTL_MS=600000

# Official guide overrides; leave empty to use the built-in OS guide.
POS_BRIDGE_HTTPS_GUIDE_IOS="https://support.apple.com/es-es/102390"
POS_BRIDGE_HTTPS_GUIDE_ANDROID="https://support.google.com/pixelphone/answer/2844832?hl=es"
POS_BRIDGE_HTTPS_GUIDE_WINDOWS="https://learn.microsoft.com/es-es/windows-hardware/drivers/install/trusted-root-certification-authorities-certificate-store"
POS_BRIDGE_HTTPS_GUIDE_MACOS="https://support.apple.com/es-es/guide/keychain-access/kyca11871/mac"
